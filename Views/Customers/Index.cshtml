@model IEnumerable<CustomerTrackingSystem.Models.Customer>

@{
    ViewBag.Title = "Customer List";
}

<h2>Customer List</h2>

@using (Html.BeginForm("Index", "Customers", FormMethod.Get))
{
    <div class="filter-panel" style="background: #f5f5f5; padding: 15px; margin-bottom: 20px; border-radius: 5px;">
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label>Name:</label>
                    @Html.TextBox("nameFilter", ViewBag.NameFilter as string, new { @class = "form-control", placeholder = "Filter by name" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label>VAT Number:</label>
                    @Html.TextBox("vatFilter", ViewBag.VATFilter as string, new { @class = "form-control", placeholder = "Filter by VAT" })
                </div>
            </div>
            <div class="col-md-4" style="padding-top: 25px;">
                <button type="submit" class="btn btn-primary">Filter</button>
                @Html.ActionLink("Clear", "Index", null, new { @class = "btn btn-default" })
            </div>
        </div>
    </div>
}

<p>
    @Html.ActionLink("Create New Customer", "Create", null, new { @class = "btn btn-success" })
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>
                @Html.ActionLink("Name", "Index", new { 
                    nameFilter = ViewBag.NameFilter, 
                    vatFilter = ViewBag.VATFilter, 
                    sortBy = "Name", 
                    sortOrder = ViewBag.SortBy == "Name" && ViewBag.SortOrder == "asc" ? "desc" : "asc",
                    page = ViewBag.CurrentPage
                })
            </th>
            <th>Address</th>
            <th>Telephone</th>
            <th>Contact Person</th>
            <th>Contact Email</th>
            <th>
                @Html.ActionLink("VAT Number", "Index", new { 
                    nameFilter = ViewBag.NameFilter, 
                    vatFilter = ViewBag.VATFilter, 
                    sortBy = "VATNumber", 
                    sortOrder = ViewBag.SortBy == "VATNumber" && ViewBag.SortOrder == "asc" ? "desc" : "asc",
                    page = ViewBag.CurrentPage
                })
            </th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Address</td>
                <td>@item.TelephoneNumber</td>
                <td>@item.ContactPersonName</td>
                <td>@item.ContactPersonEmail</td>
                <td>@item.VATNumber</td>
                <td>
                    @Html.ActionLink("Edit", "Edit", new { id = item.CustomerId }, new { @class = "btn btn-xs btn-primary" })
                    @Html.ActionLink("Delete", "Delete", new { id = item.CustomerId }, new { @class = "btn btn-xs btn-danger" })
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Pagination -->
@if (ViewBag.TotalPages > 1)
{
    <div class="pagination">
        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <a href="@Url.Action("Index", new { 
                nameFilter = ViewBag.NameFilter, 
                vatFilter = ViewBag.VATFilter, 
                sortBy = ViewBag.SortBy, 
                sortOrder = ViewBag.SortOrder, 
                page = i 
            })" 
            class="btn btn-default @(i == ViewBag.CurrentPage ? "active" : "")">@i</a>
        }
    </div>
}